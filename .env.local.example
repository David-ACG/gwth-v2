# GWTH v2 — Environment Variables
# Copy this file to .env.local and fill in the values.
# No env vars are required for Phase 1 (mock data mode).

# ─── Authentication — Better Auth (W11) ──────────────────────────────────────
# Self-hosted Better Auth (sessions in Postgres via Drizzle). Replaces Supabase
# Auth (the NEXT_PUBLIC_SUPABASE_* / SUPABASE_SERVICE_ROLE_KEY block below is
# RETIRED by W11 — a later phase removes those lines).
# Generate the secret with: openssl rand -base64 32
# BETTER_AUTH_SECRET=dev-only-change-me-openssl-rand-base64-32
# Public origin (server-side). Prod: https://gwth.ai  Dev: http://localhost:3000
# BETTER_AUTH_URL=http://localhost:3000
# Same public origin, exposed to the browser client (must match BETTER_AUTH_URL)
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# Origin used for links that LEAVE in an email (verify, reset, beta invite).
# Optional and normally unset: BETTER_AUTH_URL is used, and only a loopback one
# is replaced (src/lib/email/auth-links.ts), so no deployed copy needs this.
# Set it when the instance is reachable at an address it does not know about.
# AUTH_EMAIL_BASE_URL=https://gwth.ai

# ─── Social login (Better Auth OAuth providers) ──────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ─── Legacy auth (Phase 2 placeholders, unused — kept for reference) ─────────
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000

# ─── Database — Drizzle ORM / Postgres (W7) ──────────────────────────────────
# postgres.js connection string used by src/db (Drizzle) and drizzle-kit.
# Local dev uses the dedicated dev container (docker, port 5443).
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/gwth_v2

# ─── Supabase ──────────────────────────────────────────────────────────────────
# RETIRED by W11 (Better Auth) — these are no longer used for auth; a later phase
# removes them. Do NOT add Supabase back (subscription cancelled).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Used for auth callback redirects (prod: https://gwth.ai)

# ─── Email — Plunk (transactional emails) ────────────────────────────────────
# PLUNK_SECRET_KEY=   # shared Plunk account key — used by both the waitlist/contact
#                     # helper (src/lib/data/email.ts) AND Better Auth's W11
#                     # reset/verify emails (src/lib/email/plunk.ts). Set this one.
# PLUNK_API_KEY=      # legacy alias, accepted as a fallback only — prefer the above.

# ─── Email — MailerLite (newsletter subscriber management) ──────────────────
# MAILERLITE_API_KEY=
# MAILERLITE_GROUP_ID=

# ─── Payments (Phase 2) ──────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_COURSE_PRICE_ID=        # £29/month course subscription
# STRIPE_STAY_CURRENT_PRICE_ID=  # £7.50/month Stay Current subscription

# ─── Media storage + CDN — Cloudflare R2 + edge (D5/D6/D7, task I3) ───────────
# The site is the READ/CDN consumer of lesson media (images, intro/build MP4,
# narration audio, PDFs). Media lives in Cloudflare R2 and is served publicly
# through the edge on a media hostname. SPLIT TOKENS (D5): the site gets a
# READ/CDN-scoped R2 token; the pipeline gets a WRITE-only token — never share
# one token across both.
#
# Public CDN base — the hostname the browser fetches media from (NOT a secret,
# hence NEXT_PUBLIC_*). Point it at the R2 public/custom domain once the edge
# cutover lands, e.g. https://media.gwth.ai . Video may use the reserved
# video.gwth.ai. Leave UNSET in dev / pre-cutover: media URLs then pass through
# unchanged (src/lib/media/url.ts::mediaUrl degrades gracefully).
# NEXT_PUBLIC_MEDIA_CDN_BASE_URL=https://media.gwth.ai
#
# Server-only R2 credentials (READ/CDN token) — only needed for presigned GETs
# of private objects or the ops health probe (src/lib/media/s3.ts). Public
# lesson media does NOT need these; it is served via the CDN base above.
# S3_ENDPOINT=            # https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=              # e.g. gwth-media
# S3_ACCESS_KEY=          # R2 access key id (read-scoped token)
# S3_SECRET_KEY=          # R2 secret access key (read-scoped token)

# ─── Pipeline Import ─────────────────────────────────────────────────────────
# PIPELINE_API_KEY=              # Shared secret for pipeline → site lesson imports

# ─── Admin Beta Access ───────────────────────────────────────────────────────
# BETA_ACCESS_API_KEY=           # Optional separate secret for /api/admin/beta-access

# ─── Site Password Gate (pre-launch) ─────────────────────────────────────────
# Set this to require a password for all pages except the home page.
# Remove or leave empty to disable the password gate.
# SITE_PASSWORD=

# ─── Public Config ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://gwth.ai
# NEXT_PUBLIC_APP_NAME=GWTH.ai

# ─── Private Content Mode (W25, pre-launch) ──────────────────────────────────
# The master switch for the private content gate: labs, lesson bodies and the
# dashboard are restricted to CONTENT_ALLOWED_EMAILS while it is on.
#
# It FAILS CLOSED BY INVERSION. The gate is ON unless the value is explicitly
# the word `off` or `public`. Unset, empty, misspelt, quoted ("off"), `on`,
# `0` and `false` all leave it LOCKED, so no configuration mistake can expose
# content. `0`/`false` are deliberately NOT opening values, unlike every other
# flag here, so a `${PRIVATE_CONTENT_MODE:-0}` template default stays safe.
#
# Launch off-switch: set PRIVATE_CONTENT_MODE=off in Coolify and redeploy.
# REMOVING the variable does the opposite and re-locks the site.
#
# Local dev: uncomment the line below, or /labs and the dashboard will bounce
# you to /login.
# PRIVATE_CONTENT_MODE=off

# Comma-separated, case-insensitive allowlist of the accounts that may view
# product content while private mode is on. Falls back to ADMIN_EMAILS when
# unset or empty; both empty admits NOBODY. The server hard-exits at boot if
# private mode is on with an empty allowlist, so a misspelt variable NAME
# crash-loops the container instead of silently locking everyone out.
# CONTENT_ALLOWED_EMAILS=david@agilecommercegroup.com,familyuccelli@gmail.com
