# Supabase (same instance as GWTH)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── LLM Providers ──────────────────────────────────────────────────────────
# Set API keys for the providers you want to use.
# For scraping: first available key wins (DeepSeek > Groq > Mistral > Anthropic > Ollama)
# For benchmark: all configured providers are tested

# DeepSeek V3.2 — Best value ($0.14/$0.28 per M tokens)
# Sign up: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Groq — Free tier (Llama 3.3 70B)
# Sign up: https://console.groq.com
GROQ_API_KEY=

# Zhipu AI / GLM-5 — Top Chinese model ($0.70/$0.70 per M tokens)
# Sign up: https://open.bigmodel.cn
ZHIPU_API_KEY=

# Moonshot / Kimi K2.5 — Best instruction following ($0.85/$0.85 per M tokens)
# Sign up: https://platform.moonshot.cn
MOONSHOT_API_KEY=

# Alibaba / Qwen 3.5 — Strong reasoning ($0.80/$2.00 per M tokens)
# Sign up: https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=

# Mistral — European provider ($0.10/$0.30 per M tokens)
# Sign up: https://console.mistral.ai
MISTRAL_API_KEY=

# Anthropic Claude (optional — skip if using Claude Max without API key)
ANTHROPIC_API_KEY=
NEWSBOT_LLM_MODEL=claude-haiku-4-5-20251001

# Ollama local (no key needed — runs on P520 GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Newsletter (Phase 3) ───────────────────────────────────────────────────
# MAILERLITE_API_KEY=eyJ...
# MAILERLITE_GROUP_ID=...

# ─── Alerting ────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# ─── Runtime ─────────────────────────────────────────────────────────────────
NEWSBOT_LOG_LEVEL=INFO
NEWSBOT_DRY_RUN=false

# ─── GWTH cache revalidation (Phase 2) ──────────────────────────────────────
# GWTH_URL=https://gwth.ai
# REVALIDATION_SECRET=...
