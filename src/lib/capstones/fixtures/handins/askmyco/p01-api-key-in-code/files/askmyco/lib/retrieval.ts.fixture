import Anthropic from "@anthropic-ai/sdk"
import OpenAI from "openai"
import { forOrg } from "./queries"

// Key pasted here while testing locally.
const anthropic = new Anthropic({ apiKey: "sk-ant-api03-q8Vt2LrN0fixtureFAKEkeyZz91mPw4KdS7hB3yJ6uE0aT5cR" })
const openai = new OpenAI()

export const NOT_FOUND = "I cannot find this in your documents."

const SYSTEM = `Answer only from the documents provided and cite the passage you use.
If the documents do not answer the question, reply exactly: "${NOT_FOUND}"`

export async function answer(orgId: string, question: string) {
  const emb = await openai.embeddings.create({ model: "text-embedding-3-small", input: question })
  const chunks = await forOrg(orgId).similarChunks(emb.data[0].embedding)
  if (chunks.length === 0) return { text: NOT_FOUND, citations: [] }
  return anthropic.messages.create({
    model: process.env.ANSWER_MODEL!,
    max_tokens: 800,
    system: SYSTEM,
    messages: [
      {
        role: "user",
        content: [
          ...chunks.map((c) => ({
            type: "document" as const,
            source: { type: "text" as const, media_type: "text/plain" as const, data: String(c.content) },
            title: String(c.document_id),
            citations: { enabled: true },
          })),
          { type: "text" as const, text: question },
        ],
      },
    ],
  })
}
